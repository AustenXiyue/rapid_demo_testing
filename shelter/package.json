{
  "name": "shelter-playtest",
  "private": true,
  "description": "避难所 Playtest 联机版：Node 服务端、页面构建与测试脚本",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node --test tests/core.test.mjs",
    "test:server": "node --disable-warning=ExperimentalWarning --test tests/server.test.mjs",
    "test:lobby": "node --disable-warning=ExperimentalWarning --test tests/lobby.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "socket.io-client": "4.8.4"
  },
  "dependencies": {
    "express": "5.2.1",
    "socket.io": "4.8.4"
  }
}
